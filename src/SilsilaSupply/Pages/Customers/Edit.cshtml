@page "{id:int}"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SilsilaSupply.Pages.Customers.EditModel
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="page-head">
    <p class="page-kicker">Client base</p>
    <h1>Edit customer</h1>
    <p class="page-lead">Update the details for this customer record.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-error" role="alert">
        <strong>Action failed.</strong> @Model.ErrorMessage
    </div>
}

@if (Model.CustomerInput.Name != null || Model.ErrorMessage == null)
{
    <section class="panel panel-narrow">
        <h2>Customer details</h2>
        <form method="post" class="form-grid">
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="CustomerInput.Name">Full name</label>
                <input asp-for="CustomerInput.Name" class="form-control" autocomplete="name" />
                <span asp-validation-for="CustomerInput.Name" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="CustomerInput.Email">Email address</label>
                <input asp-for="CustomerInput.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="CustomerInput.Email" class="field-error"></span>
            </div>
            <div class="form-actions form-actions-row">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-page="/Customers" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
}
