@page "{id:int}"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SilsilaSupply.Pages.Suppliers.EditModel
@{
    ViewData["Title"] = "Edit Supplier";
}

<div class="page-head">
    <p class="page-kicker">Vendor network</p>
    <h1>Edit supplier</h1>
    <p class="page-lead">Update the details for this supplier record.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-error" role="alert">
        <strong>Action failed.</strong> @Model.ErrorMessage
    </div>
}

@if (Model.SupplierInput.Name != null || Model.ErrorMessage == null)
{
    <section class="panel panel-narrow">
        <h2>Supplier details</h2>
        <form method="post" class="form-grid">
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="SupplierInput.Name">Supplier name</label>
                <input asp-for="SupplierInput.Name" class="form-control" />
                <span asp-validation-for="SupplierInput.Name" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="SupplierInput.Email">Contact email</label>
                <input asp-for="SupplierInput.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="SupplierInput.Email" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="SupplierInput.Rating">Rating (0–5)</label>
                <input asp-for="SupplierInput.Rating" class="form-control" type="number" step="0.1" min="0" max="5" inputmode="decimal" />
                <span asp-validation-for="SupplierInput.Rating" class="field-error"></span>
            </div>
            <div class="form-actions form-actions-row">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-page="/Suppliers" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
}
