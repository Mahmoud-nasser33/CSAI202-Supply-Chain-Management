@page "{id:int}"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SilsilaSupply.Pages.Orders.EditModel
@{
    ViewData["Title"] = "Edit Order";
}

<div class="page-head">
    <p class="page-kicker">Fulfillment</p>
    <h1>Edit order</h1>
    <p class="page-lead">Update the customer, total and status for this order.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-error" role="alert">
        <strong>Action failed.</strong> @Model.ErrorMessage
    </div>
}

@if (Model.OrderInput.TotalAmount != 0 || Model.ErrorMessage == null)
{
    <section class="panel panel-narrow">
        <h2>Order details</h2>
        <form method="post" class="form-grid">
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="OrderInput.CustomerId">Customer</label>
                <select asp-for="OrderInput.CustomerId" asp-items="Model.CustomerOptions" class="form-control">
                    <option value="">Select a customer…</option>
                </select>
                <span asp-validation-for="OrderInput.CustomerId" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="OrderInput.TotalAmount">Total amount (E£)</label>
                <input asp-for="OrderInput.TotalAmount" class="form-control" type="number" step="0.01" min="0" inputmode="decimal" />
                <span asp-validation-for="OrderInput.TotalAmount" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="OrderInput.Status">Status</label>
                <input asp-for="OrderInput.Status" class="form-control" placeholder="e.g. Processing, Shipped, Delivered" />
                <span asp-validation-for="OrderInput.Status" class="field-error"></span>
            </div>
            <div class="form-actions form-actions-row">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-page="/Orders" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
}
