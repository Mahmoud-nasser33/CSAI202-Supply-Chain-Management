@page "{id:int}"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SilsilaSupply.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="page-head">
    <p class="page-kicker">Catalog</p>
    <h1>Edit product</h1>
    <p class="page-lead">Update the details for this catalog entry.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-error" role="alert">
        <strong>Action failed.</strong> @Model.ErrorMessage
    </div>
}

@if (Model.ProductInput.Name != null || Model.ErrorMessage == null)
{
    <section class="panel panel-narrow">
        <h2>Product details</h2>
        <form method="post" class="form-grid">
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ProductInput.Name">Product name</label>
                <input asp-for="ProductInput.Name" class="form-control" />
                <span asp-validation-for="ProductInput.Name" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductInput.Price">Unit price (E£)</label>
                <input asp-for="ProductInput.Price" class="form-control" type="number" step="0.01" min="0.01" inputmode="decimal" />
                <span asp-validation-for="ProductInput.Price" class="field-error"></span>
            </div>
            <div class="form-actions form-actions-row">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-page="/Products" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
}
