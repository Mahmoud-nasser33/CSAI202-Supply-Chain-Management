@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SilsilaSupply.Pages.SuppliersModel
@{
    ViewData["Title"] = "Suppliers";
}

<div class="page-head">
    <p class="page-kicker">Vendor network</p>
    <h1>Suppliers</h1>
    <p class="page-lead">The vendors that keep the Silsila Supply pipeline moving.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-error" role="alert">
        <strong>Action failed.</strong> @Model.ErrorMessage
    </div>
}

<section class="panel">
    <h2>Register a new supplier</h2>
    <form method="post" class="form-grid">
        <div class="form-group">
            <label asp-for="SupplierInput.Name">Supplier name</label>
            <input asp-for="SupplierInput.Name" class="form-control" placeholder="e.g. El-Nasr Import &amp; Export" />
            <span asp-validation-for="SupplierInput.Name" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="SupplierInput.Email">Contact email</label>
            <input asp-for="SupplierInput.Email" class="form-control" placeholder="contact@vendor.com" autocomplete="email" />
            <span asp-validation-for="SupplierInput.Email" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="SupplierInput.Rating">Rating (0–5)</label>
            <input asp-for="SupplierInput.Rating" class="form-control" type="number" step="0.1" min="0" max="5" placeholder="4.5" inputmode="decimal" />
            <span asp-validation-for="SupplierInput.Rating" class="field-error"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Register supplier</button>
        </div>
    </form>
</section>

<section class="panel">
    <h2>Supplier list</h2>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Supplier</th>
                    <th scope="col">Contact email</th>
                    <th scope="col" class="cell-num">Rating</th>
                    <th scope="col" class="cell-actions-head"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Suppliers.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty-state">No suppliers registered yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <tr>
                            <td class="cell-strong">@supplier.Name</td>
                            <td>@supplier.Email</td>
                            <td class="cell-num">
                                @if (supplier.Rating.HasValue)
                                {
                                    <span class="rating">&#9733; @supplier.Rating.Value.ToString("F1")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <a asp-page="/Suppliers/Edit" asp-route-id="@supplier.SupplierId" class="btn btn-secondary btn-sm">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@supplier.SupplierId"
                                      onsubmit="return confirm('Remove @supplier.Name? This also removes their products, stock entries and order line items.');" class="inline-form">
                                    <button type="submit" class="btn btn-danger btn-sm" aria-label="Remove supplier @supplier.Name">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
