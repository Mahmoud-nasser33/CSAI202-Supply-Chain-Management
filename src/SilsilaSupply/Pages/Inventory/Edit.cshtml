@page "{id:int}"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SilsilaSupply.Pages.Inventory.EditModel
@{
    ViewData["Title"] = "Edit Stock Level";
}

<div class="page-head">
    <p class="page-kicker">Warehousing</p>
    <h1>Adjust stock level</h1>
    <p class="page-lead">Set the exact quantity on hand for this product and warehouse.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-error" role="alert">
        <strong>Action failed.</strong> @Model.ErrorMessage
    </div>
}

@if (Model.ProductName != null || Model.ErrorMessage == null)
{
    <section class="panel panel-narrow">
        <h2>Stock entry</h2>
        <form method="post" class="form-grid">
            <input type="hidden" asp-for="Id" />
            <div class="form-group form-group-readonly">
                <label>Product</label>
                <div class="readonly-value">@(Model.ProductName ?? "—")</div>
            </div>
            <div class="form-group form-group-readonly">
                <label>Warehouse</label>
                <div class="readonly-value">@(Model.WarehouseName ?? "—")</div>
            </div>
            <div class="form-group">
                <label asp-for="QuantityInput.Quantity">Quantity on hand</label>
                <input asp-for="QuantityInput.Quantity" class="form-control" type="number" step="1" min="0" inputmode="numeric" />
                <span asp-validation-for="QuantityInput.Quantity" class="field-error"></span>
            </div>
            <div class="form-actions form-actions-row">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-page="/Inventory" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
}
