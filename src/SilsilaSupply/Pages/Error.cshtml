@page
@model SilsilaSupply.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-panel">
    <h1>Something went wrong</h1>
    <p>The request could not be completed. Please try again, or return to the <a asp-page="/Index">dashboard</a>.</p>

    @if (Model.ShowRequestId)
    {
        <p class="error-request-id">
            Reference: @Model.RequestId
        </p>
    }
</div>
